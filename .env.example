# --- PostgreSQL ---
POSTGRES_HOST=localhost          # внутри compose переопределяется на "postgres"
POSTGRES_PORT=5432
POSTGRES_DB=deals_bigdata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Генератор источника ---
N_PRICES=300000                  # объём синтетических сделок (только при первой инициализации volume)

# --- Окно загрузки ETL (backfill) ---
# Пустые значения = полная история. Пример backfill за месяц: ETL_START_DATE=2026-09-01, ETL_END_DATE=2026-09-30
ETL_START_DATE=
ETL_END_DATE=

# --- ML ---
ML_AS_OF=2026-10-26              # дата снимка; train/test границы считаются от неё
ML_RANDOM_SEED=42
